{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": @LOGO_PATH_JSON@,
    "padding": {
      "top": 1,
      "right": 3
    },
    "color": {
      "1": "#@LOGO_1@",
      "2": "#@LOGO_2@",
      "3": "#@LOGO_3@",
      "4": "#@LOGO_4@",
      "5": "#@LOGO_5@",
      "6": "#@LOGO_6@",
      "7": "#@LOGO_7@",
      "8": "#@LOGO_8@",
      "9": "#@LOGO_9@"
    }
  },

  "display": {
    "separator": "  ",
    "brightColor": false,

    "color": {
      "keys": "#@KEY@",
      "title": "#@TITLE@",
      "output": "default",
      "separator": "#@SUBTLE@"
    },

    "key": {
      "width": 10
    },

    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": null,
      "color": {
        "elapsed": "auto",
        "total": "#@BAR_EMPTY@",
        "border": "#@BAR_EMPTY@"
      },
      "width": 10
    },

    "percent": {
      "ndigits": 0,
      "color": {
        "green": "#@BAR_GOOD@",
        "yellow": "#@BAR_WARN@",
        "red": "#@BAR_BAD@"
      }
    }
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "custom",
      "format": "{##@SECTION_SYSTEM@}󰋜 SYSTEM{#}     {##@SUBTLE@}┈┈┈┈┈┈┈┈┈┈┈┈{#}"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "format": "{release}"
    },
    {
        "type": "packages",
        "key": "󰏖 Packages"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "wm",
      "key": "󰖲 WM",
      "format": "{pretty-name} {version}"
    },

    {
      "type": "custom",
      "format": "{##@SECTION_APPEARANCE@}󰏘 DESKTOP{#}    {##@SUBTLE@}┈┈┈┈┈┈┈┈┈┈┈┈{#}"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "icons",
      "key": "󰀻 Icons",
    },
    {
      "type": "terminalfont",
      "key": "󰛖 Font",
      "format": "{combined}"
    },

    {
      "type": "custom",
      "format": "{##@SECTION_HARDWARE@}󰍛 HARDWARE{#}   {##@SUBTLE@}┈┈┈┈┈┈┈┈┈┈┈┈{#}"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "format": "{name} · {temperature}",
      "temp": {
        "green": 60,
        "yellow": 80
      }
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "hideType": "integrated",
      "format": "{name} · {temperature}",
      "driverSpecific": true,
      "temp": {
        "green": 65,
        "yellow": 85
      }
    },
    {
      "type": "memory",
      "key": "󰑭 RAM",
      "format": "{used} / {total}  {percentage-bar} {percentage}",
      "percent": {
        "type": ["num", "bar"],
        "green": 60,
        "yellow": 85
      }
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "folders": ["/"],
      "format": "{size-used} / {size-total}  {size-percentage-bar} {size-percentage}",
      "percent": {
        "type": ["num", "bar"],
        "green": 70,
        "yellow": 90
      }
    },

    {
      "type": "custom",
        "format": "{##@LOGO_5@}󰏘 PALETTE{#}    {##@SUBTLE@}┈┈┈┈┈┈┈┈┈┈┈┈{#}"
    },
    {
      "type": "custom",
      "key": "󰏘 Colors",
      "format": "{##@LOGO_1@}● #@LOGO_1@{#}  {##@LOGO_5@}● #@LOGO_5@{#}  {##@LOGO_9@}● #@LOGO_9@{#}"
    },
    {
      "type": "custom",
      "format": "{##@LOGO_1@}██{##@LOGO_2@}██{##@LOGO_3@}██{##@LOGO_4@}██{##@LOGO_5@}██{##@LOGO_6@}██{##@LOGO_7@}██{##@LOGO_8@}██{##@LOGO_9@}██{#}"
    }
  ]
}
