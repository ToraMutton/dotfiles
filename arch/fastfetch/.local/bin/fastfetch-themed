#!/usr/bin/env python3

import json
import os
import re
import sys
from pathlib import Path


# current.lua がない場合に使うArch系フォールバック色
FALLBACK = {
    "primaryFixed": "8ecdf5",
    "primaryFixedDim": "69b9e8",
    "secondaryFixedDim": "70c7d4",
    "tertiaryFixedDim": "ad9eea",
    "inverseOnSurface": "aeb8c2",
    "outline": "617181",
    "errorContainer": "ff6b6b",
}


def read_palette(path: Path) -> dict[str, str]:
    if not path.is_file():
        return FALLBACK.copy()

    pattern = re.compile(
        r'^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"([0-9A-Fa-f]{6})",?\s*$'
    )

    palette = {
        match.group(1): match.group(2).lower()
        for line in path.read_text(encoding="utf-8").splitlines()
        if (match := pattern.match(line))
    }

    return FALLBACK | palette


def mix(start: str, end: str, amount: float) -> str:
    start_rgb = tuple(
        int(start[index:index + 2], 16)
        for index in (0, 2, 4)
    )
    end_rgb = tuple(
        int(end[index:index + 2], 16)
        for index in (0, 2, 4)
    )

    result = tuple(
        round(a + (b - a) * amount)
        for a, b in zip(start_rgb, end_rgb)
    )

    return "".join(f"{channel:02x}" for channel in result)


def make_gradient(palette: dict[str, str]) -> list[str]:
    anchors = [
        palette["primaryFixedDim"],
        palette["secondaryFixedDim"],
        palette["tertiaryFixedDim"],
    ]

    return [
        mix(anchors[0], anchors[1], index / 4)
        if index <= 4
        else mix(anchors[1], anchors[2], (index - 4) / 4)
        for index in range(9)
    ]


def main() -> None:
    config_home = Path(
        os.environ.get(
            "XDG_CONFIG_HOME",
            Path.home() / ".config",
        )
    )
    cache_home = Path(
        os.environ.get(
            "XDG_CACHE_HOME",
            Path.home() / ".cache",
        )
    )

    fastfetch_dir = config_home / "fastfetch"
    scheme_path = config_home / "hypr" / "scheme" / "current.lua"

    palette = read_palette(scheme_path)
    colors = make_gradient(palette)

    replacements = {
        "@LOGO_PATH_JSON@": json.dumps(
            str(fastfetch_dir / "logo.txt")
        ),
        "@KEY@": colors[0],
        "@TITLE@": palette["primaryFixed"],
        "@SUBTLE@": palette["inverseOnSurface"],
        "@BAR_GOOD@": colors[0],
        "@BAR_WARN@": colors[-1],
        "@BAR_BAD@": palette["errorContainer"],
        "@BAR_EMPTY@": palette["outline"],
        "@SECTION_SYSTEM@": colors[0],
        "@SECTION_APPEARANCE@": colors[4],
        "@SECTION_HARDWARE@": colors[8],
    }

    replacements.update({
        f"@LOGO_{index}@": color
        for index, color in enumerate(colors, 1)
    })

    template_path = fastfetch_dir / "config.jsonc.in"
    rendered = template_path.read_text(encoding="utf-8")

    for placeholder, value in replacements.items():
        rendered = rendered.replace(placeholder, value)

    output_dir = cache_home / "fastfetch"
    output_dir.mkdir(parents=True, exist_ok=True)

    output_path = output_dir / "current.jsonc"
    temporary_path = output_dir / "current.jsonc.tmp"

    temporary_path.write_text(rendered, encoding="utf-8")
    temporary_path.replace(output_path)

    os.execv(
        "/usr/bin/fastfetch",
        [
            "fastfetch",
            "-c",
            str(output_path),
            *sys.argv[1:],
        ],
    )


if __name__ == "__main__":
    main()
