{
    "agent_ui_font_size": 18.0,
    "ui_font_family": ".SystemUIFont",
    "agent_servers": {
        "antigravity-acp": {
            "default_config_options": {
                "model": "gemini-3.8-flash-high"
            },
            "type": "registry"
        },
        "gemini": {
            "type": "registry"
        },
        "codex-acp": {
            "default_config_options": {
                "model": "gpt-6-astra",
                "reasoning_effort": "high",
            },
            "type": "registry",
        },
        "claude-acp": {
            "default_config_options": {
                "fast": false,
                "model": "opus",
                "effort": "medium",
            },
            "type": "registry",
        },
    },

    "agent": {
        "tool_permissions": {
            "default": "confirm",
            "tools": {
                "terminal": {
                    "default": "confirm",
                    "always_allow": [
                        { "pattern": "^node\\s+" },
                        { "pattern": "^npm\\s+(run|test)\\b" },
                        { "pattern": "^npx\\s+playwright\\b" },
                    ],
                    "always_deny": [{ "pattern": "^git\\s+" }],
                },
            },
        },
    },

    "edit_predictions": { "provider": "zed" },

    "vim_mode": true,
    "ui_font_size": 18.0,
    "buffer_font_size": 16.0,
    "theme": "One Dark",
    "tab_size": 4,
    "format_on_save": "on",
    "autosave": "on_focus_change",
    "relative_line_numbers": "disabled",
    "cli_default_open_behavior": "existing_window",

    "languages": {
        "TypeScript": { "tab_size": 2 },
        "JavaScript": { "tab_size": 2 },
        "C": { "tab_size": 4 },
        "Rust": { "show_edit_predictions": false,
                  "tab_size": 4 },
    },

    "lsp": {
        "texlab": {
            "settings": {
                "texlab": {
                    "build": {
                        "onSave": true,
                    },
                },
            },
        },
    },

    "ssh_connections": [
        { "host": "uec-sol", "projects": [] },
        { "host": "ced-orange", "projects": [] },
        { "host": "ied", "projects": [] },
    ],
}
